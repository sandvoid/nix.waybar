{
  "layer": "top",
  "position": "top",
  "font": "Iosevka Nerd Font 10",
  "modules-left": ["hyprland/window"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "clock",
    "tray"                                        
  ],

"hyprland/workspaces": {
  "format":"{icon}"
},

   "network": {
   "format-wifi":"WIFI {signalStrength}% |",
   "format-ethernet":"Wired",
   "interface":"wlp3s0",
   "format-disconnected": "",
   "tooltip": true,
   "interval": 10
},

  "pulseaudio": {
    "format": "VOL {volume}% |",
    "format-muted": "MUTED |",  
    "on-click": "pavucontrol"
},


  "battery": {
     "format": "BAT {capacity}% |",
     "format-charging": "CHG {capacity}% |",
},
   
 "clock": {
  "format":"{:%H:%M}"
  }
}
